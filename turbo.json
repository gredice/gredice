{
    "$schema": "https://v2-9-16.turborepo.dev/schema.json",
    "concurrency": "12",
    "globalEnv": [
        "GREDICE_CI_BLOB_FIXTURES",
        "GREDICE_CI_NETWORK_ISOLATION",
        "TEST_ENV",
        "NEXT_FONT_GOOGLE_MOCKED_RESPONSES",
        "GREDICE_PLAYWRIGHT_FEATURED_GARDENS_FIXTURE",
        "GREDICE_STORAGE_TEST_DB_ADMIN_URL",
        "GREDICE_API_HOST",
        "GREDICE_NEWS_HOST",
        "NEXT_TELEMETRY_DISABLED",
        "NEXT_PUBLIC_VERCEL_ENV",
        "VERCEL_ENV",
        "POSTGRES_URL"
    ],
    "globalPassThroughEnv": [
        "NODE_OPTIONS"
    ],
    "globalDependencies": [
        "scripts/blob-test-fixtures.mjs",
        "scripts/ci-blob-network-guard.mjs",
        "apps/www/public/assets/plants/placeholder.png",
        "scripts/ci-isolated-tests.sh",
        "scripts/ci-test-app.sh",
        "scripts/ci-font-fixtures.cjs",
        "packages/storage/scripts/seedCiCatalogue.ts",
        "packages/storage/tests/fixtures/ci-catalogue.json",
        "scripts/ci-api-fixtures.mjs"
    ],
    "tasks": {
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "passThroughEnv": [
                "COOKIE_DOMAIN"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "public/sitemap*.xml",
                "public/robots.txt"
            ]
        },
        "clean": {
            "cache": false
        },
        "lint": {},
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ],
            "outputs": []
        },
        "lint:migrate": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": [
                "build"
            ]
        },
        "db-generate": {
            "cache": false,
            "outputs": [
                "packages/storage/src/migrations/**"
            ]
        },
        "db-push": {
            "cache": false
        },
        "regenerate": {
            "cache": false,
            "dependsOn": [
                "^regenerate"
            ],
            "inputs": [
                ".env*"
            ],
            "outputs": [
                "libs/flags/**"
            ]
        },
        "generate:models-types": {
            "cache": false,
            "outputs": [
                "packages/game/src/data/gameAssetModels.generated.ts",
                "packages/game/src/models/GameAssets.tsx"
            ]
        }
    }
}
