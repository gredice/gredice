{
    "name": "@gredice/transactional",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        ".react-email"
    ],
    "scripts": {
        "clean": "rimraf .turbo dist build out coverage tsconfig.tsbuildinfo",
        "test": "pnpm run test:node",
        "test:node": "node --import tsx --test ./tests/**/*.node.spec.tsx",
        "lint": "biome check --write",
        "lint:migrate": "biome migrate --write",
        "dev": "email dev -p 4001"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@gredice/ui": "workspace:*",
        "@react-email/ui": "6.9.5",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "24.13.6",
        "@types/react": "19.2.18",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@gredice/js": "workspace:*",
        "@gredice/notifications": "workspace:*",
        "react": "19.2.8",
        "react-email": "6.9.5"
    }
}
