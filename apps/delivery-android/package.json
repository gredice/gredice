{
    "name": "@gredice/delivery-android",
    "version": "0.1.0",
    "private": true,
    "description": "Thin Android and Android Auto shell for Gredice Delivery.",
    "scripts": {
        "android:bundle": "./gradlew --no-daemon bundleRelease",
        "android:clean": "./gradlew --no-daemon clean",
        "android:verify": "./gradlew --no-daemon lintRelease testDebugUnitTest assembleDebug bundleRelease",
        "contract:validate": "node ../../scripts/validate-delivery-car-contract.mjs",
        "store:validate": "node ../../scripts/validate-android-store-listing.mjs apps/delivery-android --allow-missing-screenshots"
    }
}
