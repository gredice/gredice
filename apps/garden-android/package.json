        "contract:validate": "node ../../scripts/validate-garden-twa-contract.mjs",
        "store:validate": "node ../../scripts/validate-android-store-listing.mjs apps/garden-android"
    },
    "gredice": {
        "bubblewrapVersion": "1.25.0"
    }
}
