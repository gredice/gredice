{
    "name": "@gredice/garden-android",
    "version": "2.0.0",
    "private": true,
    "description": "Android Trusted Web Activity wrapper for Gredice Garden.",
    "scripts": {
        "android:bundle": "./gradlew --no-daemon bundleRelease",
        "android:clean": "./gradlew --no-daemon clean",
