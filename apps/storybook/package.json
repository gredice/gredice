{
    "name": "storybook",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rimraf .turbo dist build out coverage .vercel storybook-static",
        "lint": "biome check --write",
        "lint:migrate": "biome migrate --write",
        "typecheck": "tsc --noEmit --pretty false",
        "dev": "node ../../scripts/run-app-command.mjs dev",
        "storybook": "node ../../scripts/run-app-command.mjs storybook",
        "build": "pnpm run typecheck && storybook build --output-dir storybook-static",
        "build-storybook": "pnpm run build"
    },
    "dependencies": {
        "@gredice/game": "workspace:*",
        "@gredice/js": "workspace:*",
        "@gredice/ui": "workspace:*",
        "@tailwindcss/typography": "0.5.20",
        "@tanstack/react-query": "5.105.0",
        "@vercel/analytics": "2.0.1",
        "next": "16.4.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-markdown": "10.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@storybook/addon-a11y": "10.6.3",
        "@storybook/addon-docs": "10.6.3",
        "@storybook/addon-mcp": "10.6.3",
        "@storybook/nextjs-vite": "10.6.3",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "nuqs": "2.10.2",
        "postcss": "8.5.31",
        "storybook": "10.6.3",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.5"
    },
    "engines": {
        "node": "26.x"
    }
}
