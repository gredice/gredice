{
    "name": "www",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rimraf .next .turbo dist build out coverage .vercel storybook-static public/sitemap*.xml public/robots.txt",
        "lint": "biome check --write",
        "lint:migrate": "biome migrate --write",
        "typecheck": "next typegen && tsc --noEmit --pretty false",
        "dev": "node ../../scripts/run-app-command.mjs dev",
        "build": "next build",
        "start": "node ../../scripts/run-app-command.mjs start",
        "test": "pnpm run test:public-profile && pnpm run test:pricing && pnpm run test:plant-sowing-price && pnpm run test:preview-backfill && pnpm run test:wallpapers && pnpm run test:plant-operation-stages && pnpm run test:seeds && pnpm run test:block-routes && pnpm run test:pets && pnpm run test:delivery-summary && pnpm run test:static-data && pnpm run test:plant-catalogue && pnpm run test:sitemap && pnpm run test:canonical-urls && pnpm run test:tracking && pnpm run test:seo && pnpm run test:cms-pages && pnpm run test:faq && pnpm run test:prepare:routes && pnpm run test:run",
        "test:regional-calendar": "node --import tsx --test ./lib/plants/regionalCalendar.node.spec.ts",
        "test:prepare": "turbo build --filter=www && pnpm run test:prepare:routes",
        "test:prepare:routes": "pnpm run test:regional-calendar && node --import tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local ./tests/populate-test-cases.ts",
        "test:run": "playwright test --project=chromium",
        "test:pricing": "node --experimental-strip-types --test ./app/cjenik/pricingRows.node.spec.ts ./components/attributes/shouldShowThirtyDayLowestPrice.node.spec.ts && playwright test --config playwright.pricing.config.ts",
        "test:plant-sowing-price": "node --experimental-strip-types --test ./lib/plants/resolvePlantSowingPrice.node.spec.ts",
        "test:preview-backfill": "node --experimental-strip-types --test ./app/vrtovi/publicGardenPreviewBackfill.unit.ts",
        "test:wallpapers": "node --experimental-strip-types --test ./app/pozadine/wallpaperComposer.node.spec.ts ./app/pozadine/macOSDynamicWallpaper.node.spec.ts",
        "test:plant-operation-stages": "node --experimental-strip-types --test ./tests/plantOperationStageAvailability.node.spec.ts",
        "test:seeds": "node --experimental-strip-types --test ./app/sjeme/seedPresentation.node.spec.ts ./tests/directoryRevalidationPaths.node.spec.ts ./tests/plantSortSeeds.node.spec.ts",
        "test:block-routes": "node --experimental-strip-types --test ./lib/blocks/blockRoute.node.spec.ts ./lib/blocks/blockPagePresentation.node.spec.ts",
        "test:sitemap": "node --experimental-strip-types --test ./tests/sitemapSources.node.spec.ts ./tests/sitemapRouteCoverage.node.spec.ts",
        "sitemap:inventory": "node --import tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local ./generate/sitemap-inventory.ts",
        "test:static-data": "node --experimental-strip-types --test ./tests/staticGenerationData.node.spec.ts ./app/dostava/termini/deliverySlotFormatting.node.spec.ts ./app/landingFeaturedGardens.node.spec.ts && pnpm run test:landing-featured-gardens",
        "test:landing-featured-gardens": "node --import tsx --conditions=react-server --test ./app/getLandingFeaturedGardens.node.spec.ts",
        "test:canonical-urls": "node --import tsx --test ./tests/canonicalUrls.node.spec.ts",
        "test:tracking": "node --experimental-strip-types --test ./app/api/tracking/trackingOrigin.node.spec.ts",
        "test:pets": "node --import tsx --test ./lib/pets/gardenPetSearch.node.spec.ts",
        "test:delivery-summary": "node --import tsx --test ./app/dostava/deliverySummary.node.spec.ts",
        "test:seo": "node --experimental-strip-types --test ./components/shared/seo/structuredDataValidation.node.spec.ts ./lib/seo/cmsPageMetadata.node.spec.ts ./lib/seo/publicMetadata.node.spec.ts ./lib/seo/publicOgSignature.node.spec.ts ./lib/seo/resolvePublicOgImage.node.spec.ts",
        "test:faq": "playwright test --config playwright.faq.config.ts",
        "test:cms-pages": "node --experimental-strip-types --test ./tests/cmsPages.node.spec.ts ./components/faq/faqCategoryArtwork.node.spec.ts ./components/faq/faqContent.node.spec.ts && pnpm run test:regional-calendar",
        "test-ui": "pnpm run test:prepare && playwright test --project=chromium --ui",
        "generate-playwright": "node ./generate/populate-test-cases.js && playwright test --config playwright-generate.config.ts",
        "generate-playwright:blocks": "node ./generate/populate-test-cases.js && playwright test --config playwright-generate.config.ts generate/blocks-snapshots.specgen.tsx",
        "generate-playwright:blocks:top-down": "node ./generate/populate-test-cases.js && playwright test --config playwright-generate.config.ts generate/blocks-top-down-snapshots.specgen.tsx",
        "generate-playwright:operation-covers": "playwright test --config playwright-generate.config.ts generate/operation-cover-snapshots.specgen.tsx",
        "generate-playwright:plants": "playwright test --config playwright-generate.config.ts generate/plants-snapshots.specgen.tsx",
        "generate-playwright:ui": "node ./generate/populate-test-cases.js && playwright test --config playwright-generate.config.ts --ui",
        "operation-covers:sync-urls": "pnpm --dir ../../packages/storage exec tsx --conditions=react-server --env-file=.env ../../apps/www/generate/sync-operation-cover-urls.ts",
        "operation-covers:verify": "pnpm --dir ../../packages/storage exec tsx --conditions=react-server ../../apps/www/generate/verify-operation-cover-assets.ts",
        "operation-covers:verify-public": "pnpm run test:prepare && OPERATION_COVER_PUBLIC_QA=1 playwright test --project=chromium tests/operation-cover-public.spec.ts",
        "test:local": "pnpm run test:prepare && pnpm run test:run",
        "test:llms": "node --experimental-strip-types --test ./app/llms-routes.spec.ts",
        "test:public-profile": "node --import tsx --test ./tests/publicProfile.node.spec.ts ./app/postignuca/achievementAvailability.node.spec.ts && playwright test --config playwright.profile.config.ts",
        "faq-categories:sync-images": "node --import tsx --conditions=react-server --env-file=../../packages/storage/.env ./generate/sync-faq-category-images.ts",
        "test:plant-catalogue": "node --import tsx --test ./app/biljke/plantCatalogue.node.spec.ts",
        "test:public-html": "playwright test --config playwright.public-html.config.ts"
    },
    "dependencies": {
        "@flags-sdk/vercel": "1.4.9",
        "@googlemaps/js-api-loader": "2.1.1",
        "@mdxeditor/editor": "4.2.5",
        "@opentelemetry/api-logs": "0.222.0",
        "@opentelemetry/resources": "2.11.0",
        "@opentelemetry/sdk-logs": "0.222.0",
        "@posthog/next": "0.9.0",
        "@vercel/blob": "2.8.0",
        "@vercel/functions": "3.9.8",
        "@vercel/toolbar": "0.2.7",
        "flags": "4.3.1",
        "next": "16.3.5",
        "next-themes": "0.4.6",
        "nuqs": "2.10.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "0.0.1",
        "sharp": "0.35.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@biomejs/biome": "2.5.14",
        "@gredice/client": "workspace:*",
        "@gredice/directory-types": "workspace:*",
        "@gredice/game": "workspace:*",
        "@gredice/js": "workspace:*",
        "@gredice/storage": "workspace:*",
        "@gredice/ui": "workspace:*",
        "@playwright/experimental-ct-react": "1.62.1",
        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@tailwindcss/typography": "0.5.20",
        "@tanstack/react-query": "5.103.2",
        "@types/google.maps": "3.66.3",
        "@types/node": "24.13.6",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/xml2js": "0.4.14",
        "@vercel/analytics": "2.0.1",
        "dotenv": "18.0.2",
        "motion": "13.4.0",
        "postcss": "8.5.16",
        "react-confetti-boom": "2.0.1",
        "react-markdown": "10.1.0",
        "tailwindcss": "4.3.3",
        "tailwindcss-animate": "1.0.7",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "xml2js": "0.6.2"
    }
}
