CHECKLY_API_KEY=
# Optional when the API key only has one Checkly account.
CHECKLY_ACCOUNT_ID=
CHECKLY_STATUS_TAG=gredice-status
# Read-only PostgreSQL role with column-level access to the allowlisted domain
# event columns and the sanitized status_live_events table.
GREDICE_LIVE_DATABASE_URL=
# Write-only integration role limited to the two status_live_* tables.
GREDICE_LIVE_INGEST_DATABASE_URL=
# HMAC secrets used to verify raw Vercel Drain and GitHub webhook deliveries.
GREDICE_LIVE_VERCEL_DRAIN_SECRET=
GREDICE_LIVE_GITHUB_WEBHOOK_SECRET=
