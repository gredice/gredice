{
    "name": "status",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rimraf .next .turbo dist build out coverage .vercel",
        "lint": "biome check --write",
        "lint:migrate": "biome migrate --write",
        "dev": "node ../../scripts/run-app-command.mjs dev",
        "build": "next build",
        "start": "node ../../scripts/run-app-command.mjs start",
        "test": "pnpm run test:node",
        "test:node": "node --import tsx --test --conditions=react-server ./lib/**/*.node.spec.ts",
        "test:disconnect": "node --import tsx --test --experimental-test-module-mocks --conditions=react-server --test-timeout=60000 ./tests/livePools.disconnect.ts",
        "test:buffer": "node --import tsx --test --conditions=react-server --test-timeout=60000 ./tests/activityBuffer.redis.ts",
        "typecheck": "next typegen && tsc --noEmit --pretty false"
    },
    "dependencies": {
        "next": "16.3.8",
        "pg": "8.23.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "server-only": "0.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@gredice/ui": "workspace:*",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "24.19.1",
        "@types/pg": "8.23.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "postcss": "8.5.29",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
