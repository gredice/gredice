{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "pnpm install --frozen-lockfile",
    "schedules": {
        "live-flush": {
            "path": "/api/live/flush",
            "schedule": "*/10 * * * *",
            "requestMethod": "GET",
            "jitter": 1
        },
        "live-retention": {
            "path": "/api/live/retention",
            "schedule": "7 * * * *",
            "requestMethod": "GET",
            "jitter": 1
        }
    }
}
