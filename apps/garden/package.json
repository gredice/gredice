{
    "name": "garden",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rimraf .next .turbo dist build out coverage .vercel storybook-static",
        "lint": "biome check --write",
        "lint:migrate": "biome migrate --write",
        "typecheck": "next typegen && tsc --noEmit --pretty false",
        "dev": "node ../../scripts/run-app-command.mjs dev",
        "build": "next build",
        "start": "node ../../scripts/run-app-command.mjs start",
        "profile:game": "GAME_PROFILE_BUILD=1 GAME_PROFILE_BASE_URL=http://localhost:3101 GAME_PROFILE_START_SERVER=1 node scripts/profile-game-scene.mjs",
        "profile:game:autumn-launch": "GAME_PROFILE_SCENARIO_SET=autumn-launch GAME_PROFILE_BUILD=1 GAME_PROFILE_START_SERVER=1 GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 node scripts/profile-game-scene.mjs",
        "profile:game:all": "GAME_PROFILE_SCENARIO_SET=all pnpm run profile:game",
        "profile:game:cross-tier": "GAME_PROFILE_SCENARIO_SET=cross-tier GAME_PROFILE_FAIL_ON_BUDGET=1 pnpm run profile:game",
        "profile:game:dense": "GAME_PROFILE_SCENARIO_SET=dense pnpm run profile:game",
        "profile:game:dense-mobile": "GAME_PROFILE_SCENARIO_SET=dense-mobile pnpm run profile:game",
        "profile:game:fauna": "GAME_PROFILE_SCENARIO_SET=fauna GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:garden-switch": "GAME_PROFILE_SCENARIO_SET=garden-switch GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:lifecycle": "GAME_PROFILE_SCENARIO_SET=lifecycle GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:lifecycle-live": "GAME_PROFILE_SCENARIO_SET=lifecycle-live GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:runtime-owners": "GAME_PROFILE_SCENARIO_SET=runtime-owners GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:runtime-scheduler-acceptance": "GAME_PROFILE_SCENARIO_SET=static-idle,lifecycle-live,runtime-owners GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:runtime-baselines": "GAME_PROFILE_SCENARIO_SET=fauna,garden-switch,lifecycle GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:regression-baselines": "GAME_PROFILE_SCENARIO_SET=cross-tier,fauna,garden-switch,lifecycle GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:compare": "node scripts/compare-game-profile-reports.mjs",
        "profile:game:high-target": "GAME_PROFILE_SCENARIO_SET=high-target pnpm run profile:game",
        "profile:game:high-target-operation-visuals": "GAME_PROFILE_SCENARIO_SET=high-target-operation-visuals pnpm run profile:game",
        "profile:game:high-target-static-scene-cache": "GAME_PROFILE_SCENARIO_SET=high-target-static-scene-cache GAME_PROFILE_FAIL_ON_BUDGET=1 GAME_PROFILE_SCREENSHOTS=1 pnpm run profile:game",
        "profile:game:existing": "node scripts/profile-game-scene.mjs",
        "profile:game:start": "GAME_PROFILE_BASE_URL=http://localhost:3101 GAME_PROFILE_START_SERVER=1 node scripts/profile-game-scene.mjs",
        "profile:game:ci": "GAME_PROFILE_FAIL_ON_BUDGET=1 pnpm run profile:game",
        "test": "pnpm run test:posthog && pnpm run test:sw && pnpm run test:profile && pnpm run test:discovery && pnpm run test:run",
        "test:ci:prepare": "pnpm run test:posthog && pnpm run test:sw && pnpm run test:profile && pnpm run test:discovery",
        "test:prepare": "turbo build --filter=garden",
        "test:run": "playwright test",
        "test:profile": "node --experimental-strip-types --test scripts/profile-game-scene.unit.mjs scripts/compare-game-profile-reports.unit.mjs scripts/static-cache-clearance.unit.mjs scripts/fauna-trajectory-contract.unit.mjs app/debug/profile/game/profileFlags.unit.ts app/debug/profile/game/profileGardenSwitch.unit.ts app/debug/profile/game/profileWeather.unit.ts app/debug/profile/game/profileDate.unit.ts app/debug/profile/game/profileAudio.unit.ts && node --import tsx --test app/debug/profile/game/profileAutumnLaunch.unit.ts",
        "test:discovery": "node --import tsx --experimental-test-module-mocks --test app/kestenijada/KestenijadaDiscoveryEntry.unit.ts",
        "test:sw": "node --test tests/push-notifications-sw.node.spec.mjs",
        "test-ui": "pnpm run test:prepare && playwright test --ui",
        "generate-playwright:tutorial-task-list-icon": "playwright test --config playwright-generate.config.ts generate/tutorial-task-list-icon.specgen.tsx",
        "generate:models-types": "node ../../scripts/generate-game-model-types.mjs",
        "test:local": "pnpm run test:prepare && pnpm run test:run",
        "test:posthog": "node --import tsx --test ./lib/posthog-server.node.spec.ts"
    },
    "dependencies": {
        "@flags-sdk/vercel": "1.5.3",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/resources": "3.0.0",
        "@opentelemetry/sdk-logs": "3.0.0",
        "@posthog/next": "0.9.0",
        "@vercel/functions": "3.10.3",
        "@vercel/toolbar": "0.2.7",
        "flags": "4.4.0",
        "next": "16.4.3",
        "next-themes": "0.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "server-only": "0.0.1",
        "sharp": "0.35.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@gredice/client": "workspace:*",
        "@gredice/game": "workspace:*",
        "@gredice/js": "workspace:*",
        "@gredice/ui": "workspace:*",
        "@playwright/experimental-ct-react": "1.62.1",
        "@playwright/test": "1.62.1",
        "@react-three/fiber": "9.8.2",
        "@tailwindcss/postcss": "4.3.3",
        "@tailwindcss/typography": "0.5.20",
        "@tanstack/react-query": "5.105.0",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vercel/analytics": "2.0.1",
        "nuqs": "2.10.2",
        "postcss": "8.5.32",
        "sass": "1.106.1",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": "26.x"
    }
}
