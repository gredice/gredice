{
    "name": "farm",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rimraf .next .turbo dist build out coverage .vercel storybook-static",
        "lint": "biome check --write",
        "lint:migrate": "biome migrate --write",
        "dev": "node ../../scripts/run-app-command.mjs dev",
        "build": "next build",
        "start": "node ../../scripts/run-app-command.mjs start",
        "test": "pnpm run test:run",
        "test:prepare": "turbo build --filter=farm",
        "test:run": "playwright test",
        "test-ui": "pnpm run test:prepare && playwright test --ui",
        "test:local": "pnpm run test:prepare && pnpm run test:run",
        "generate:pwa-install-assets": "playwright test --config playwright-generate.config.ts generate/pwa-install-assets.specgen.tsx"
    },
    "dependencies": {
        "@opentelemetry/api-logs": "0.222.0",
        "@opentelemetry/resources": "2.11.0",
        "@opentelemetry/sdk-logs": "0.222.0",
        "@posthog/next": "0.9.0",
        "@posthog/react": "1.11.3",
        "@vercel/blob": "2.8.0",
        "@vercel/functions": "3.9.11",
        "@vercel/toolbar": "0.2.7",
        "flags": "4.3.1",
        "next": "16.3.8",
        "pg": "8.23.1",
        "posthog-js": "1.436.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "server-only": "0.0.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@biomejs/biome": "2.5.15",
        "@gredice/auth": "workspace:*",
        "@gredice/client": "workspace:*",
        "@gredice/js": "workspace:*",
        "@gredice/label-printer": "workspace:*",
        "@gredice/notifications": "workspace:*",
        "@gredice/storage": "workspace:*",
        "@gredice/ui": "workspace:*",
        "@playwright/experimental-ct-react": "1.62.1",
        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@tailwindcss/typography": "0.5.20",
        "@tanstack/react-query": "5.104.1",
        "@types/node": "24.19.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vercel/analytics": "2.0.1",
        "postcss": "8.5.29",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2"
    }
}
