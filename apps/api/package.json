{
    "name": "api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./routes": "./export/index.ts"
    },
    "scripts": {
        "clean": "rimraf .next .turbo dist build out coverage .vercel storybook-static",
        "lint": "biome check --write",
        "lint:migrate": "biome migrate --write",
        "dev": "node ../../scripts/run-app-command.mjs dev",
        "build": "node ./scripts/migratePreviewDatabase.mjs && next build",
        "start": "node ../../scripts/run-app-command.mjs start",
        "test": "pnpm run /^test:.*/",
        "test:run": "playwright test",
        "test:node": "node --import tsx --test --conditions=react-server ./lib/**/*.node.spec.ts",
        "mcp:smoke:public": "node ./scripts/smokePublicMcp.mjs",
        "checkout:resume-direct": "node --conditions=react-server --env-file=.env --import tsx ./scripts/resumeDirectCheckout.ts",
        "migrate:raised-beds:single-block": "node --conditions=react-server --env-file=.env --import tsx ./scripts/migrateRaisedBedsToSingleBlock.ts",
        "regenerate": "pnpm run /^regenerate:.*/",
        "regenerate:directories-api": "pnpm dlx openapi-typescript https://api.gredice.com/api/docs/directories -o ./lib/@types/directories-api/v1.d.ts"
    },
    "dependencies": {
        "@date-fns/tz": "1.5.0",
        "@gredice/google": "workspace:*",
        "@gredice/ui": "workspace:*",
        "@hono/mcp": "0.3.2",
        "@hono/standard-validator": "0.4.0",
        "@modelcontextprotocol/sdk": "1.30.0",
        "@opentelemetry/api-logs": "0.222.0",
        "@opentelemetry/resources": "2.11.0",
        "@opentelemetry/sdk-logs": "0.222.0",
        "@posthog/next": "0.9.0",
        "@scalar/api-reference-react": "0.9.71",
        "@standard-community/standard-json": "0.3.6",
        "@standard-community/standard-openapi": "0.2.10",
        "@upstash/redis": "1.39.0",
        "@valibot/to-json-schema": "1.8.0",
        "@vercel/blob": "2.8.0",
        "@vercel/functions": "3.9.8",
        "@vercel/sandbox": "3.3.0",
        "ai": "7.0.108",
        "date-fns": "4.4.0",
        "drizzle-orm": "0.45.3",
        "hono": "4.13.8",
        "hono-openapi": "1.3.3",
        "hono-rate-limiter": "0.5.4",
        "next": "16.3.5",
        "pg": "8.23.0",
        "prettier": "3.9.8",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "0.0.1",
        "suncalc": "2.0.2",
        "valibot": "1.5.0",
        "web-push": "3.6.7",
        "xml2js": "0.6.2",
        "zod": "4.6.5",
        "zod-openapi": "6.0.2",
        "zod-to-json-schema": "3.25.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@gredice/auth": "workspace:*",
        "@gredice/directory-types": "workspace:*",
        "@gredice/email": "workspace:*",
        "@gredice/fiscalization": "workspace:*",
        "@gredice/js": "workspace:*",
        "@gredice/notifications": "workspace:*",
        "@gredice/signalco": "workspace:*",
        "@gredice/storage": "workspace:*",
        "@gredice/stripe": "workspace:*",
        "@gredice/transactional": "workspace:*",
        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "24.13.6",
        "@types/pg": "8.23.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/suncalc": "1.9.2",
        "@types/web-push": "3.6.4",
        "@types/xml2js": "0.4.14",
        "@vercel/analytics": "2.0.1",
        "jsonwebtoken": "9.0.3",
        "openapi-types": "12.1.3",
        "postcss": "8.5.28",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
